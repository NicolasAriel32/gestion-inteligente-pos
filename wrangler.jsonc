{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestion-inteligente-pos",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-22",
  "send_metrics": false,
  "build": {
    "command": "npm run build:workers",
    "watch_dir": ["frontend/src", "frontend/index.html", "frontend/public"]
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
